# Токен бота от @BotFather (обязателен для прода)
BOT_TOKEN=

# Username бота без @ и short names мини-аппов (создаются в BotFather через /newapp)
BOT_USERNAME=your_bot
APP_WATERSORT=watersort
APP_GALAXY=galaxy
APP_SNOWBALL=snowball

# Порт API и путь к базе
PORT=8787
DB_PATH=data/games.db

# Только для локальной разработки:
# DEV_AUTH=1  — принимать `Authorization: dev <id> <имя>` без подписи
# NO_BOT=1    — не запускать long polling (API работает без бота)
