# Пример конфигурации water-sort. Скопируй в .env и заполни под своё окружение.

# URL бэкенда @games/server. Пусто — игра живёт на локальных данных/моках.
VITE_API_URL=http://localhost:8787

# Юзернейм бота (без @) и short name мини-аппа — для реф-ссылок и шеринга.
VITE_BOT_USERNAME=
VITE_APP_SHORT_NAME=

# Dev-обход подписи initData: "<id> <имя>" (работает при DEV_AUTH=1 на сервере).
VITE_DEV_AUTH=1 Дев
