# Пример окружения galaxy. Скопируй в .env и заполни под свой стенд.

# Адрес API бэкенда (@games/server). Пусто = офлайн-режим на локальных данных.
VITE_API_URL=http://localhost:8787

# Username бота (без @) — для реф-ссылок и шеринга.
VITE_BOT_USERNAME=

# Short name мини-аппа из BotFather (t.me/<bot>/<short_name>).
VITE_APP_SHORT_NAME=

# Dev-обход подписи initData: "<id> <имя>" (работает только при DEV_AUTH=1 на сервере).
VITE_DEV_AUTH=1 Дев
